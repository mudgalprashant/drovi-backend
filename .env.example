# Copy to .env and fill in. NEVER commit .env — .gitignore blocks it.
# For Northflank, set these as environment variables / secrets on the service.

# --- Database: Supabase, via the SESSION pooler (port 5432, NOT 6543) --------
# Supabase dashboard -> Connect -> "Session pooler". Note the username carries
# the project ref: postgres.<project-ref>
DROVI_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DROVI_DB_USERNAME=postgres.<project-ref>
DROVI_DB_PASSWORD=
DROVI_DB_POOL_MAX=5

# --- Firebase (identity) ----------------------------------------------------
DROVI_FIREBASE_PROJECT_ID=
# The service-account JSON, base64-encoded, as a single line:
#   base64 -i firebase-adminsdk-xxxx.json | tr -d '\n'
DROVI_FIREBASE_CREDENTIALS_B64=

# --- Model provider ---------------------------------------------------------
# The base URL, model and auth header NAME live in the ai_provider_config table,
# not here -- switching provider or model must be an UPDATE, not a release.
# Only the secret is an environment variable, and the row names which one:
# ai_provider_config.api_key_env_var.
#
# Until this is set, leave ai_provider_config.active = false. A provider marked
# active with no key fails every call at request time instead of at startup,
# which is the worse failure.
DROVI_ANTHROPIC_API_KEY=

# --- Runtime ----------------------------------------------------------------
DROVI_PORT=8080
DROVI_LOG_LEVEL=INFO
DROVI_PUBLIC_BASE_URL=https://<your.domain>
